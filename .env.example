# Copy to apps/web/.env.local for local development. Never commit real values.
# Added as each phase needs them; documented here so nothing is a surprise.

# Phase 4 — PostgreSQL (Neon). Pooled URL for the app, direct URL for migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Phase 4 — auth. Generate each with: openssl rand -base64 48
# SESSION_SECRET=
# JWT_SECRET=

# Phase 7 — transactional email
# RESEND_API_KEY=
