# Copy to apps/web/.env.local for local development. Never commit real values.

# PostgreSQL. On Neon: pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgresql://postgres@localhost:5432/sbtv_dev
# DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth secrets, 32+ characters each. Generate with: openssl rand -base64 48
SESSION_SECRET=
JWT_SECRET=

# DB-backed tests (npm run test:db). Defaults to localhost:5433/sbtv_test.
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/sbtv_test

# Phase 7 — transactional email
# RESEND_API_KEY=
