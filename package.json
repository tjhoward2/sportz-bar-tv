{
  "name": "sportz-bar-tv",
  "private": true,
  "description": "Tells bartenders which game to put on, on which provider and channel, right now.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev:web": "npm run dev -w @sbtv/web",
    "dev:mobile": "npm run start -w @sbtv/mobile",
    "build": "npm run build -w @sbtv/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test:db": "npm run test:db -w @sbtv/web",
    "db:migrate": "npm run db:migrate -w @sbtv/web",
    "db:seed": "npm run db:seed -w @sbtv/web"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
